@model BE_0302.Models.Category
@{ ViewBag.Title = "Xóa danh mục"; }
<h2 class="page-title bg-success">Xóa danh mục</h2>
@Html.ValidationSummary(false, "", new { @class = "text-danger" })
<dl class="dl-horizontal"><dt>Mã danh mục</dt><dd>@Model.CategoryID</dd><dt>Tên danh mục</dt><dd>@Model.CategoryName</dd></dl>

<p class="alert alert-warning">Bạn có chắc muốn xóa danh mục này?</p>
@using (Html.BeginForm())
{
    @Html.AntiForgeryToken()
    <button type="submit" class="btn btn-danger">Xác nhận xóa</button>
}

<div class="form-actions">@Html.ActionLink("Quay lại danh sách", "Index", null, new { @class = "btn btn-default" })</div>
