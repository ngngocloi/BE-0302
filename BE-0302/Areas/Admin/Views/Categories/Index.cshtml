@model IEnumerable<BE_0302.Models.Category>
@{
    ViewBag.Title = "Index";
    Layout = "~/Areas/Admin/View/Shared/_AdminLayout.cshtml";
}

<h2 class="bg-success">Danh sách danh mục</h2>

<table class="table bg-info col-md-12">
    <tr>
        <th class="col-md-8 bg-success">
            @*@Html.DisplayNameFor(model => model.CategoryName)*@
            Tên Danh Mục
        </th>
        <th class="bg-success col-md-4"></th>
    </tr>
    @foreach (var item in Model)
            {
                <tr>
                    <td>
                        @Html.DisplayFor(modelItem => item.CategoryName)
                    </td>
                    <td>
                        @Html.ActionLink("Sửa", "Edit", new { id = item.CategoryID }, new { @class ="btn btn-primary btn-sm"})
                        @*@Html.ActionLink("Thông tin", "Details", new { id = item.CategoryID })*@
                        @Html.ActionLink("Xóa bỏ", "Delete", new { id = item.CategoryID }, new { @class = "btn btn-primary btn-sm" })
                    </td>
                </tr>
            }
</table>
<p>
    @Html.ActionLink("Thêm Mới", "Create", null, new { @class = "btn btn-primary"})
</p>
