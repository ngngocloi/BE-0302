@model BE_0302.Models.ViewModel.AdminSearchVM
@using PagedList.Mvc
@{ ViewBag.Title = "Tài khoản admin"; }
<h2 class="page-title bg-success">TÀI KHOẢN ADMIN</h2>
@using (Html.BeginForm("Index", "Users", FormMethod.Get, new { @class = "search-form form-inline" }))
{
    <label for="Keyword">Tên đăng nhập</label>
    @Html.TextBoxFor(m => m.Keyword, new { @class = "form-control" })
    <button type="submit" class="btn btn-primary">Tìm kiếm</button>
    @Html.ActionLink("Đặt lại", "Index", null, new { @class = "btn btn-default" })
}
<p>Tổng số: @Model.Users.TotalItemCount tài khoản.</p>
<div class="table-responsive"><table class="table admin-table">
    <thead><tr><th>Tên đăng nhập</th><th>Vai trò</th><th>Thao tác</th></tr></thead><tbody>
    @foreach (var item in Model.Users)
    {
        <tr><td>@item.Username</td><td>Quản trị viên</td><td class="actions">
            @Html.ActionLink("Sửa", "Edit", new { id = item.Username }, new { @class = "btn btn-primary btn-sm" })
            @Html.ActionLink("Chi tiết", "Details", new { id = item.Username }, new { @class = "btn btn-info btn-sm" })
            @Html.ActionLink("Xóa", "Delete", new { id = item.Username }, new { @class = "btn btn-danger btn-sm" })
        </td></tr>
    }
    @if (Model.Users.Count == 0) { <tr><td colspan="3">Không có tài khoản phù hợp.</td></tr> }
    </tbody>
</table></div>
@Html.PagedListPager(Model.Users, page => Url.Action("Index", new { page, Model.Keyword }))
@Html.ActionLink("Thêm mới", "Create", null, new { @class = "btn btn-primary" })
