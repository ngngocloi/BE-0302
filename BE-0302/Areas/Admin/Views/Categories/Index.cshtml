@model IEnumerable<BE_0302.Models.Category>
@{ ViewBag.Title = "Danh sách danh mục"; }
<h2 class="page-title bg-success">DANH SÁCH DANH MỤC</h2>
<div class="table-responsive">
<table class="table admin-table">
    <thead><tr><th>Mã danh mục</th><th>Tên danh mục</th><th>Thao tác</th></tr></thead>
    <tbody>
    @foreach (var item in Model)
    {
        <tr><td>@item.CategoryID</td><td>@item.CategoryName</td><td class="actions">
            @Html.ActionLink("Sửa", "Edit", new { id = item.CategoryID }, new { @class = "btn btn-primary btn-sm" })
            @Html.ActionLink("Chi tiết", "Details", new { id = item.CategoryID }, new { @class = "btn btn-info btn-sm" })
            @Html.ActionLink("Xóa", "Delete", new { id = item.CategoryID }, new { @class = "btn btn-danger btn-sm" })
        </td></tr>
    }
    @if (!Model.Any()) { <tr><td colspan="3">Chưa có danh mục.</td></tr> }
    </tbody>
</table></div>
@Html.ActionLink("Thêm mới", "Create", null, new { @class = "btn btn-primary" })
