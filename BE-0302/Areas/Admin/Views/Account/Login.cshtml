@model BE_0302.Models.ViewModel.LoginVM
@{ ViewBag.Title = "Đăng nhập quản trị"; }
<div class="auth-form">
<h2 class="page-title bg-success">Đăng nhập quản trị</h2>
@using (Html.BeginForm("Login", "Account", new { returnUrl = ViewBag.ReturnUrl }, FormMethod.Post, null))
{
    @Html.AntiForgeryToken()
    @Html.ValidationSummary(false, "", new { @class = "text-danger" })
    <div class="form-group">@Html.LabelFor(m => m.Username)
        @Html.TextBoxFor(m => m.Username, new { @class = "form-control", autocomplete = "username" })</div>
    <div class="form-group">@Html.LabelFor(m => m.Password)
        @Html.PasswordFor(m => m.Password, new { @class = "form-control", autocomplete = "current-password" })</div>
    <button type="submit" class="btn btn-primary">Đăng nhập</button>
}
@if (ViewBag.CanSetup == true)
{
    <p class="form-actions">@Html.ActionLink("Tạo quản trị viên đầu tiên", "Setup")</p>
}
</div>
@section scripts { @Scripts.Render("~/bundles/jqueryval") }
