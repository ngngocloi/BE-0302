@model BE_0302.Models.ViewModel.AdminUserVM
@{ ViewBag.Title = "Tạo quản trị viên đầu tiên"; ViewBag.IsEdit = false; }
<div class="auth-form">
<h2 class="page-title bg-success">Tạo quản trị viên đầu tiên</h2>
@using (Html.BeginForm())
{
    @Html.AntiForgeryToken()
    @Html.ValidationSummary(false, "", new { @class = "text-danger" })
    @Html.Partial("~/Areas/Admin/Views/Users/PVCreateEdit.cshtml", Model)
    <button type="submit" class="btn btn-primary">Tạo tài khoản</button>
    @Html.ActionLink("Đăng nhập", "Login", null, new { @class = "btn btn-default" })
}
</div>
@section scripts { @Scripts.Render("~/bundles/jqueryval") }
