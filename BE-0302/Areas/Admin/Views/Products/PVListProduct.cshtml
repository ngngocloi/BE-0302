@model BE_0302.Models.ViewModel.ProductSearchVM
@using PagedList.Mvc
<p>Tìm thấy <strong>@Model.Products.TotalItemCount</strong> sản phẩm.</p>
<div class="table-responsive"><table class="table admin-table">
    <thead><tr><th>Hình ảnh</th><th>Tên sản phẩm</th><th>Đơn giá</th><th>Danh mục</th><th>Thao tác</th></tr></thead>
    <tbody>
    @foreach (var item in Model.Products)
    {
        <tr><td><img class="product-thumbnail" src="@Url.Content(item.ImageUrl)" alt="@item.ProductName" onerror="this.onerror=null;this.src='@Url.Content("~/Content/images/default-product.svg")';" /></td>
        <td>@item.ProductName</td><td>@item.ProductPrice.ToString("N0") đ</td><td>@(item.Category == null ? "" : item.Category.CategoryName)</td>
        <td class="actions">
            @Html.ActionLink("Sửa", "Edit", new { id = item.ProductID }, new { @class = "btn btn-primary btn-sm" })
            @Html.ActionLink("Chi tiết", "Details", new { id = item.ProductID }, new { @class = "btn btn-info btn-sm" })
            @Html.ActionLink("Xóa", "Delete", new { id = item.ProductID }, new { @class = "btn btn-danger btn-sm" })
        </td></tr>
    }
    @if (Model.Products.Count == 0) { <tr><td colspan="5">Không có sản phẩm phù hợp.</td></tr> }
    </tbody>
</table></div>
@if (Model.Products.PageCount > 0) { <p>Trang @Model.Products.PageNumber / @Model.Products.PageCount</p> }
@Html.PagedListPager(Model.Products, page => Url.Action("Index", new { page, Model.Keyword, Model.MinPrice, Model.MaxPrice, Model.SortOrder }))
