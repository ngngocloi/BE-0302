<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewBag.Title - My Store</title>
    @Styles.Render("~/Content/css")
    <link href="@Url.Content("~/Content/Admin.css")" rel="stylesheet" />
    @Scripts.Render("~/bundles/modernizr")
</head>
<body>
    <nav class="navbar navbar-inverse navbar-fixed-top" aria-label="Quản trị">
        <div class="container">
            <div class="navbar-header">
                <button type="button" class="navbar-toggle" data-toggle="collapse" data-target="#admin-menu" aria-label="Mở menu" aria-expanded="false">
                    <span class="icon-bar"></span><span class="icon-bar"></span><span class="icon-bar"></span>
                </button>
                @Html.ActionLink("My Store", "Index", "AdminHome", new { area = "Admin" }, new { @class = "navbar-brand" })
            </div>
            <div id="admin-menu" class="navbar-collapse collapse">
                @if (Session["AdminUsername"] != null)
                {
                    <ul class="nav navbar-nav">
                        <li>@Html.ActionLink("Home", "Index", "AdminHome", new { area = "Admin" }, null)</li>
                        <li>@Html.ActionLink("Danh mục", "Index", "Categories", new { area = "Admin" }, null)</li>
                        <li>@Html.ActionLink("Sản phẩm", "Index", "Products", new { area = "Admin" }, null)</li>
                        <li>@Html.ActionLink("Khách hàng", "Index", "Customers", new { area = "Admin" }, null)</li>
                        <li>@Html.ActionLink("Đơn hàng", "Index", "Orders", new { area = "Admin" }, null)</li>
                        <li>@Html.ActionLink("Tài khoản", "Index", "Users", new { area = "Admin" }, null)</li>
                    </ul>
                    using (Html.BeginForm("Logout", "Account", new { area = "Admin" }, FormMethod.Post, new { @class = "navbar-form navbar-right" }))
                    {
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-default btn-sm">Đăng xuất</button>
                    }
                }
            </div>
        </div>
    </nav>
    <main class="container body-content">
        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success" role="status">@TempData["Success"]</div>
        }
        @RenderBody()
        <hr />
        <footer><p>&copy; @DateTime.Now.Year - My Store</p><p>Trang quản trị BE-0302</p></footer>
    </main>
    @Scripts.Render("~/bundles/jquery")
    @Scripts.Render("~/bundles/bootstrap")
    @RenderSection("scripts", required: false)
</body>
</html>
