@model BE_0302.Models.Category
@{ ViewBag.Title = "Cập nhật danh mục"; }
<h2 class="page-title bg-success">Cập nhật danh mục</h2>
@using (Html.BeginForm())
{
    @Html.AntiForgeryToken()
    @Html.ValidationSummary(false, "", new { @class = "text-danger" })
    @Html.HiddenFor(m => m.CategoryID)
    <div class="form-horizontal">
        @Html.Partial("PVCreateEdit", Model)
        <div class="form-group"><div class="col-md-offset-2 col-md-10">
            <button type="submit" class="btn btn-primary">Lưu</button>
            @Html.ActionLink("Quay lại danh sách", "Index", null, new { @class = "btn btn-default" })
        </div></div>
    </div>
}
@section scripts { @Scripts.Render("~/bundles/jqueryval") }
